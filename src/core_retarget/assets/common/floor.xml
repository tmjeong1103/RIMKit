<mujoco model="core-floor">
  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.1 0.1 0.1" specular="0.9 0.9 0.9"/>
    <rgba haze="0.15 0.25 0.35 1"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.5 0.9" rgb2="0 0 0"
             width="512" height="3072"/>
    <texture type="2d" name="core_ground_texture" builtin="checker" mark="edge"
             rgb1="0.9 0.9 0.9" rgb2="0.8 0.8 0.8" markrgb="0.8 0.8 0.8"
             width="1000" height="1000"/>
    <material name="core_ground_material" texture="core_ground_texture"
              texuniform="true" texrepeat="1 1" reflectance="0.1"/>
  </asset>

  <worldbody>
    <light pos="0 0 5.5" dir="0 0 -1" diffuse="0.5 0.5 0.5"
           directional="true" specular="0.3 0.3 0.3" castshadow="false"/>
    <light pos="0 0 3" dir="0 0 -1" diffuse="0.2 0.2 0.2"
           directional="false" mode="trackcom" castshadow="true"/>
    <geom name="floor" group="1" size="0 0 0.05" type="plane"
          material="core_ground_material"/>
  </worldbody>
</mujoco>
